# Copy this file to .env and fill in the values. Docker Compose reads .env
# automatically; the app refuses to start if a required value is missing.

# Browser origins allowed by CORS, comma-separated. Wildcard (*) is not
# allowed because credentials are enabled — list each origin explicitly.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# HMAC signing key for JWTs. Must be at least 256 bits (32+ characters);
# use a randomly generated value, never a dictionary phrase.
JWT_SECRET=

# PostgreSQL password. Compose passes it to the db container and to the
# backend as SPRING_DATASOURCE_PASSWORD.
DB_PASSWORD=

# Set to "demo" to seed the demo account (demo@example.com / password123)
# and its sample data. Leave empty for a clean database (production).
SPRING_PROFILES_ACTIVE=demo
